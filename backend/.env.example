PORT=3000
NODE_ENV=development

# Локально через docker-compose: postgresql://postgres:postgres@localhost:5432/user_support_service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_support_service

# Сгенерируйте свою строку от 32 символов, например: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

ALLOWED_ORIGINS=http://localhost:5173
